# Copiez en .env pour le développement local (ne jamais committer .env).
# En production, ces valeurs sont saisies dans Coolify (Environment Variables).

DATABASE_URL=mysql://root:root@localhost:3307/pause
PUBLIC_URL=http://localhost:3100
PORT=3100

# Super admin créé au premier démarrage s'il n'en existe aucun (12 caractères minimum)
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=

# Décalage horaire des équipes par rapport à UTC (Maroc : 0)
LOCAL_OFFSET_HOURS=0
